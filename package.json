{
  "name": "resume-portfolio",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "agent"
  ],
  "scripts": {
    "start": "npm run site --workspace portfolio-agent",
    "agent": "npm run start --workspace portfolio-agent",
    "export:public": "node scripts/export-public-profile.mjs",
    "test": "node --test scripts/export-public-profile.test.mjs && npm test --workspace portfolio-agent",
    "test:browser": "node scripts/browser-smoke.mjs",
    "typecheck": "npm run typecheck --workspace portfolio-agent"
  },
  "devDependencies": {
    "playwright": "1.65.1"
  }
}
